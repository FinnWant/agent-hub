# Agent Hub configuration. Copy to /opt/agent-hub/.env (mode 600, owner agenthub).
# Never commit the real .env.

# --- Network
BIND_HOSTS=127.0.0.1,<tailscale-ip>
PORT=8090
PREVIEW_PORT_RANGE=8200-8299

# --- Docker (rootless, per-user daemon)
DOCKER_HOST=unix:///run/user/1001/docker.sock

# --- Auth (set with: agent-hub set-password)
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# --- Capacity (protects everything else on the host)
MAX_CONCURRENT_SANDBOXES=2
DEFAULT_SANDBOX_MEMORY=2g
MAX_SANDBOX_MEMORY=4g
TOTAL_SANDBOX_MEMORY=6g
MEMORY_RESERVE=3g
DEFAULT_SANDBOX_CPUS=2
SANDBOX_PIDS_LIMIT=512
MIN_FREE_DISK=15g

# --- Frontend development without Docker
DEMO_MODE=false

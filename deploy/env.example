# Kiln configuration. install.sh copies this to /opt/agent-hub/.env (mode 600,
# owner agenthub) and fills in the blanks. Never commit the real .env.

# --- HTTPS via `tailscale serve` (install.sh sets these up; HTTPS=off keeps plain HTTP).
# With HTTPS, Kiln listens on 127.0.0.1 only and Tailscale serves it at PUBLIC_URL.
HTTPS=tailscale
PUBLIC_URL=
TRUST_PROXY=false

# --- Network: specific addresses only, never 0.0.0.0. install.sh fills in the Tailscale IP.
BIND_HOSTS=127.0.0.1,<tailscale-ip>
PORT=8090
PREVIEW_PORT_RANGE=8200-8299
# Previews bind to the Tailscale IP only and are linked by MagicDNS name (install.sh fills both).
# The name must differ from the host you open Kiln on; logins on it are refused.
PREVIEW_BIND=<tailscale-ip>
PREVIEW_HOST=<machine>.<tailnet>.ts.net

# --- Docker (agenthub's rootless daemon; install.sh sets this)
DOCKER_HOST=unix:///run/user/<agenthub-uid>/docker.sock
IMAGE_VERSION=3

# --- Auth (set with: python -m app.set_password; SESSION_SECRET is generated at install)
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# --- Capacity (protects everything else on the host)
MAX_CONCURRENT_SANDBOXES=2
DEFAULT_SANDBOX_MEMORY=2g
MAX_SANDBOX_MEMORY=4g
TOTAL_SANDBOX_MEMORY=6g
MEMORY_RESERVE=3g
DEFAULT_SANDBOX_CPUS=2
MAX_SANDBOX_CPUS=4
SANDBOX_PIDS_LIMIT=512
MIN_FREE_DISK=15g
# Below this, running sandboxes are stopped so the disk can't fill up.
DISK_EMERGENCY_FREE=5g

# --- Disk I/O throttling per sandbox (install.sh sets the device if the io controller is delegated)
SANDBOX_IO_DEVICE=
SANDBOX_IO_READ_BPS=200m
SANDBOX_IO_WRITE_BPS=100m

# --- Agent credentials (set with: python -m app.set_secret claude|github; never commit them)
# Claude: output of `claude setup-token` (your subscription; for your own use only).
# Kept in the Claude gateway container; agents get a per-run key instead. Redacted from logs.
CLAUDE_CODE_OAUTH_TOKEN=
# gateway (default) or direct (puts the token itself in the sandbox; only if the gateway fails)
CLAUDE_TOKEN_MODE=gateway
# GitHub: fine-grained token, selected repositories, Contents read/write (not Workflows).
# Used only by Kiln itself on the host (clone and push); never enters a sandbox.
GITHUB_TOKEN=

# --- Agent runs
RUN_TIMEOUT_DEFAULT=1800
RUN_TIMEOUT_MAX=14400
RUN_MAX_TURNS_DEFAULT=50
# Checks (a sandbox's verify command): time limit per run of them, and how many times
# failing checks send the agent back before it may stop anyway.
VERIFY_TIMEOUT=600
VERIFY_MAX_REPAIRS=3
# Owner requests: approvals denied after APPROVAL_TIMEOUT, runs over budget stopped after
# BUDGET_WAIT, kiln-ask waits ASK_WAIT (seconds); usage is read every METER_INTERVAL seconds.
APPROVAL_TIMEOUT=600
BUDGET_WAIT=1800
ASK_WAIT=90
METER_INTERVAL=3
# Checkpoints at most every CHECKPOINT_INTERVAL s, CHECKPOINT_DEBOUNCE s after file edits;
# loop breaker: the same failing call LOOP_REPEATS times within LOOP_WINDOW calls.
CHECKPOINT_INTERVAL=60
CHECKPOINT_DEBOUNCE=15
LOOP_REPEATS=3
LOOP_WINDOW=10
AGENT_MODEL=

# --- Browser terminal
MAX_TERMINALS=4
TERMINAL_IDLE_TIMEOUT=3600

# --- Storage / modes
DB_PATH=/opt/agent-hub/data/agent-hub.db
DEMO_MODE=false
